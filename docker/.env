UID=1000 #$(id -u)
GID=1000 #$(id -g)

# X11
XAUTHORITY=/tmp/.docker.xauth
DISPLAY=:0 # echo $DISPLAY

# For Fedora
QT_QPA_PLATFORM=wayland
WAYLAND_DISPLAY=wayland-0
XDG_RUNTIME_DIR=/run/user/1000  # /run/user/$(id -u)

# === Update config below ===
ROS_ENV="jazzy"
ROS_TYPE="desktop"  # Options: core, base, desktop, simulation, desktop_full
